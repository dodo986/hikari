#!/usr/bin/env bash
# Starts the daemon when it is not up, then hands the window its arguments.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"

window() {
	for candidate in "$here/hikari-ui" /usr/lib/hikari/hikari-ui; do
		if [ -x "$candidate" ]; then
			echo "$candidate"
			return 0
		fi
	done
	command -v hikari-ui 2>/dev/null
}

ui="$(window || true)"
if [ -z "$ui" ]; then
	echo "hikari: the window (hikari-ui) is missing; install it or run scripts/build-window.sh" >&2
	exit 1
fi

daemon_up() { "$here/hikari" status >/dev/null 2>&1; }

if ! daemon_up; then
	if systemctl --user start hikarid >/dev/null 2>&1; then
		:
	elif command -v systemd-run >/dev/null 2>&1 && systemd-run --user --unit=hikarid "$here/hikarid" >/dev/null 2>&1; then
		:
	else
		setsid -f "$here/hikarid" >/dev/null 2>&1 || true
	fi
fi
for _ in $(seq 1 40); do
	if daemon_up; then break; fi
	sleep 0.1
done

# nxm://<game>/mods/<id>/files/<id>?key=... lands in the window, which asks the
# daemon to start the download once it is connected.
if pgrep -f -x "$ui" >/dev/null 2>&1; then
	for arg in "$@"; do
		case "$arg" in
			nxm://*)
				exec "$here/hikari" mods nxm "$arg"
				;;
		esac
	done
	exit 0
fi

exec "$ui" "$@"
